    affiliation: "University of South Carolina"
repository-code: "https://github.com/iamsssahmadi/discourse-to-pnt"
url: "https://iamsssahmadi.github.io/discourse-to-pnt/"
license: MIT
year: 2026
keywords:
  - aphasia
  - Philadelphia Naming Test
  - discourse analysis
  - speech-language pathology
  - natural language processing
